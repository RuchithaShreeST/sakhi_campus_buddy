  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "vite --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.web.json --noEmit",
    "test:types": "npm run typecheck",
    "test:unit": "node --test tests/*.test.js",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && node --experimental-strip-types --test tests/*.test.js tests/*.test.ts && npm run test:components",
    "lint": "eslint src/web src/data"
  },
  "private": true
