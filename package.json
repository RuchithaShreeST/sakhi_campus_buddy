{
  "name": "sakhi",
  "version": "1.0.0",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "web": "vite --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.web.json --noEmit",
    "test:types": "npm run typecheck",
    "test:unit": "node --test tests/*.test.js",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && node --experimental-strip-types --test tests/*.test.js tests/*.test.ts && npm run test:components",
    "lint": "eslint src/web src/data"
  },
  "private": true
}
