# Public client configuration only. Never put AI provider secrets in Expo.
EXPO_PUBLIC_SAKHI_API_URL=http://localhost:8787
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ENV=development


# Server-side environment variables belong in the server environment, not this file.
AI_API_KEY=
AI_MODEL=
AI_PROVIDER=
AI_ENDPOINT=

# Server-only database configuration. Never expose service-role credentials to Expo.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SAKHI_CORS_ALLOWLIST=http://localhost:5173
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
